#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
    --legacy) shift; exec python /usr/share/veldora/shell/main.py "$@" ;;
    --overview) exec qs ipc -c veldora call veldora overview ;;
    --controls) exec qs ipc -c veldora call veldora controls ;;
    --reload) qs kill -c veldora || true; exec qs -n -c veldora -d ;;
    --lock)
        qs ipc -c veldora call veldora privacy true || true
        trap 'qs ipc -c veldora call veldora privacy false || true' EXIT
        hyprlock
        ;;
    --launcher) exec qs ipc -c veldora call veldora launcher ;;
    --toggle) exec qs ipc -c veldora call veldora island ;;
    --control)
        case "${2:-}" in
            volume-up) wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
            volume-down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
            mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
            brightness-up) brightnessctl --class=backlight set +5% ;;
            brightness-down) brightnessctl --class=backlight --min-value=1 set 5%- ;;
            *) echo 'Unknown control' >&2; exit 2 ;;
        esac
        ;;
    '') exec qs -n -c veldora ;;
    *) echo 'Usage: veldora-shell [--overview|--launcher|--toggle|--controls|--reload|--lock|--control ACTION|--legacy]' >&2; exit 2 ;;
esac
